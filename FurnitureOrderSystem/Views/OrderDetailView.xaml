<UserControl x:Class="FurnitureOrderSystem.Views.OrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FurnitureOrderSystem.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Order Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Заказ №" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="{Binding Order.Id}" FontSize="16" FontWeight="Bold" Margin="5,0,0,0"/>
            <TextBlock Text="от" FontSize="16" Margin="10,0,0,0"/>
            <TextBlock Text="{Binding Order.OrderDate, StringFormat={}{0:dd.MM.yyyy}}" FontSize="16" Margin="5,0,0,0"/>
        </StackPanel>

        <!-- Customer Info -->
        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Margin="0,10,0,10" Padding="10">
            <StackPanel>
                <TextBlock Text="Клиент:" FontWeight="Bold"/>
                <TextBlock Text="{Binding Order.Customer.Name}" Margin="10,5,0,0"/>
                <TextBlock Text="{Binding Order.Customer.Phone}" Margin="10,5,0,0"/>
                <TextBlock Text="{Binding Order.Customer.Address}" Margin="10,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Order Items -->
        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding Order.OrderItems}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Продукт" Binding="{Binding Product.Name}" Width="*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat={}{0:C}}" Width="Auto"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="Auto"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Path=., Converter={StaticResource OrderItemTotalConverter}}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Order Summary -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="Итого:" FontWeight="Bold" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding Order.TotalAmount, StringFormat={}{0:C}}" FontWeight="Bold"/>
        </StackPanel>

        <!-- Status Controls -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
            <ComboBox SelectedValue="{Binding Order.Status}" Width="150" Margin="0,0,10,0">
                <ComboBoxItem Content="Новый"/>
                <ComboBoxItem Content="В производстве"/>
                <ComboBoxItem Content="Готов"/>
                <ComboBoxItem Content="Доставлен"/>
            </ComboBox>
            <Button Content="Обновить статус" 
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding UpdateStatusCommand}"
                    CommandParameter="{Binding ElementName=StatusComboBox, Path=SelectedValue}"/>
        </StackPanel>
    </Grid>
</UserControl>