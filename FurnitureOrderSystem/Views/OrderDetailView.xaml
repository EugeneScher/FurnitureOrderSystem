<UserControl x:Class="FurnitureOrderSystem.Views.OrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Стиль для статусов в ComboBox -->
        <Style TargetType="ComboBoxItem" x:Key="StatusComboBoxItemStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Content}" Value="Новый">
                    <Setter Property="Foreground" Value="Green"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Content}" Value="В производстве">
                    <Setter Property="Foreground" Value="Orange"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Content}" Value="Готов">
                    <Setter Property="Foreground" Value="Blue"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Content}" Value="Доставлен">
                    <Setter Property="Foreground" Value="Purple"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка заказа -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Заказ №" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="{Binding Order.Id}" FontSize="16" FontWeight="Bold" Margin="5,0,0,0"/>
            <TextBlock Text="от" FontSize="16" Margin="10,0,0,0"/>
            <TextBlock Text="{Binding Order.OrderDate, StringFormat={}{0:dd.MM.yyyy}}" FontSize="16" Margin="5,0,0,0"/>
        </StackPanel>

        <!-- Информация о клиенте -->
        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Margin="0,10,0,10" Padding="10">
            <StackPanel>
                <TextBlock Text="Клиент:" FontWeight="Bold"/>
                <TextBlock Text="{Binding Order.Customer.Name}" Margin="10,5,0,0"/>
                <TextBlock Text="{Binding Order.Customer.Phone}" Margin="10,5,0,0"/>
                <TextBlock Text="{Binding Order.Customer.Address}" Margin="10,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Список товаров -->
        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding Order.OrderItems}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="0,0,0,10"
                  materialDesign:DataGridAssist.CellPadding="10,5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Продукт" Binding="{Binding Product.Name}" Width="*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat={}{0:C}}" Width="Auto"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="Auto"/>
                <DataGridTextColumn Header="Сумма" Width="Auto">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0:C}">
                            <Binding Path="UnitPrice"/>
                            <Binding Path="Quantity"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Итоговая сумма -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="Итого:" FontWeight="Bold" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding Order.TotalAmount, StringFormat={}{0:C}}" FontWeight="Bold"/>
        </StackPanel>

        <!-- Управление статусом -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
            <ComboBox x:Name="StatusComboBox" 
                      SelectedValue="{Binding Order.Status}" 
                      Width="150" 
                      Margin="0,0,10,0"
                      ItemContainerStyle="{StaticResource StatusComboBoxItemStyle}">
                <ComboBoxItem Content="Новый"/>
                <ComboBoxItem Content="В производстве"/>
                <ComboBoxItem Content="Готов"/>
                <ComboBoxItem Content="Доставлен"/>
            </ComboBox>
            <Button Content="Обновить статус" 
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding UpdateStatusCommand}"
                    CommandParameter="{Binding ElementName=StatusComboBox, Path=SelectedValue}"/>
        </StackPanel>
    </Grid>
</UserControl>
