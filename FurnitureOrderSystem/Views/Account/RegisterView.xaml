<UserControl x:Class="FurnitureOrderSystem.Views.Account.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="400">
    <ScrollViewer>
        <Grid Margin="20">
            <StackPanel>
                <TextBlock Text="Регистрация" 
                           FontSize="24" 
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBox materialDesign:HintAssist.Hint="Имя"
                         Text="{Binding FirstName}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0,10"/>

                <TextBox materialDesign:HintAssist.Hint="Фамилия"
                         Text="{Binding LastName}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0,10"/>

                <TextBox materialDesign:HintAssist.Hint="Email"
                         Text="{Binding Email}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0,10"/>

                <TextBox materialDesign:HintAssist.Hint="Логин"
                         Text="{Binding Username}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0,10"/>

                <PasswordBox materialDesign:HintAssist.Hint="Пароль"
                            x:Name="PasswordBox"
                            Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                            Margin="0,10"/>

                <PasswordBox materialDesign:HintAssist.Hint="Подтвердите пароль"
                            x:Name="ConfirmPasswordBox"
                            Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                            Margin="0,10"/>

                <Button Content="Зарегистрироваться"
                        Command="{Binding RegisterCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        HorizontalAlignment="Stretch"
                        Margin="0,20,0,10"/>

                <TextBlock Text="Уже есть аккаунт? Войдите" 
                           HorizontalAlignment="Center"
                           Foreground="Blue"
                           Cursor="Hand"
                           TextDecorations="Underline">
                    <TextBlock.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToLoginCommand}"/>
                    </TextBlock.InputBindings>
                </TextBlock>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>